include LICENSE
include README.md
include CHANGELOG.md
include pyproject.toml

# Everything the suite reads, so `pytest` works from the sdist.  Listing
# extensions instead of a wildcard missed a different directory each time:
# tests/data held eleven of sixteen fixtures and no MANIFEST.json, the .tsv
# reference and tests/reference were absent, and tests/validation/baseline and
# tests/perf went missing too -- each breaking a different test module.
recursive-include tests *
recursive-include tools *

# Runnable walkthrough referenced from the README.
recursive-include examples *

# Documentation sources (generated with `python tools/gen_api_docs.py`) and the
# figures the guide pages link to; test_docs.py checks every relative link.
recursive-include docs *

global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .pytest_cache
include mkdocs.yml

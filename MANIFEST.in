include LICENSE
include README.md
include CHANGELOG.md
include pyproject.toml

# Test suite and every file it reads, so `pytest` works from the sdist.
# `tests/data` holds .csv, .tsv and MANIFEST.json; `tests/reference` holds the
# R/Stata dumps the pinned numbers come from.  A wildcard on *.csv shipped
# eleven of sixteen fixtures and no manifest, and the manifest test also wants
# tools/r_reference/*.R, so a sdist user could not run the suite at all --
# which the comment here claimed was the point of including tests/.
recursive-include tests *.py
recursive-include tests/data *
recursive-include tests/reference *

# Runnable walkthrough referenced from the README.
recursive-include examples *.py

# Documentation sources (generated with `python tools/gen_api_docs.py`) and the
# figures the guide pages link to; test_docs.py checks every relative link.
recursive-include docs *.md
recursive-include docs *.yml
recursive-include docs *.png
recursive-include docs *.svg
recursive-include tools *.py
recursive-include tools *.R
recursive-include tools *.stan
include mkdocs.yml
